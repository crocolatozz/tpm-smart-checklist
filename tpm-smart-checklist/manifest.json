{
  "manifest_version": 3,
  "name": "TPM Smart Checklist",
  "version": "2.1.0",
  "description": "TPM Smart Checklist untuk Operator 1–3 pada web TPM dengan sinkronisasi Cloud Firestore, deteksi halaman & tanggal otomatis, Dev Mode, dan engine toggle 3-state.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TPM Smart Checklist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html"
}
